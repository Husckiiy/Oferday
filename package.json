{
  "name": "telegram-to-whatsapp-forwarder",
  "version": "1.0.0",
  "description": "Ferramenta para clonar mensagens e ofertas de canais do Telegram para WhatsApp",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "pm2:start": "npx pm2 start ecosystem.config.cjs",
    "pm2:stop": "npx pm2 stop ecosystem.config.cjs",
    "pm2:restart": "npx pm2 restart ecosystem.config.cjs",
    "pm2:logs": "npx pm2 logs bot-promocoes",
    "pm2:status": "npx pm2 status"
  },
  "keywords": [
    "telegram",
    "whatsapp",
    "gramjs",
    "baileys",
    "bot",
    "forwarder"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.13",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "pm2": "^7.0.4",
    "qrcode": "^1.5.4",
    "telegram": "^2.26.16"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/qrcode": "^1.5.5",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
